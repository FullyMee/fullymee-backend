PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://app.example.com
FRONTEND_ORIGIN=https://app.example.com
API_ORIGIN=https://api.example.com

# MongoDB (runtime database)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?appName=<cluster-name>
MONGODB_DB=messaging_app
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_MS=60000

# Redis (Production rate limiting and scaling cluster)
REDIS_URL=redis://default:password@your-redis-server.com:6379

JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=7d
ADMIN_USER_IDS=
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_MAX_AGE_MS=604800000
OTP_EXPIRES_MIN=5
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFY_LOCK_MIN=15
CONFESSION_ROOM_DEFAULT_CAPACITY=50
CONFESSION_MAX_JOINED_ROOMS=3
CONFESSION_TIMED_ROOM_DURATION_MIN=240
CONFESSION_POSTS_PER_MIN=6
CONFESSION_REPLIES_PER_MIN=12
CONFESSION_REACTIONS_PER_MIN=30
CONFESSION_REPORTS_PER_HOUR=20
CONFESSION_REPORT_AUTO_HIDE_THRESHOLD=3
CONFESSION_SPAM_WINDOW_SEC=180
CONFESSION_SPAM_DUPLICATE_LIMIT=2
MESSAGE_TTL_MIN=5
# Mongo TTL index auto-deletes expired messages. Keep worker disabled unless needed.
ENABLE_MESSAGE_CLEANUP_WORKER=false
ENABLE_CONFESSION_ROOM_EXPIRY_WORKER=true
MESSAGE_CLEANUP_BATCH=1000
SHUTDOWN_TIMEOUT_MS=10000

# SMTP settings (Google SMTP recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Azino <your-email@gmail.com>
OTP_EMAIL_SUBJECT=Your OTP for Secure Access
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Audio confessions (Cloudinary stores audio as video resources)
AUDIO_ENABLED=false
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AUDIO_FOLDER=fm-audio
AUDIO_FILE_TTL_HOURS=72
AUDIO_PLAY_URL_TTL_HOURS=4
AUDIO_MAX_DURATION_SECONDS=30
AUDIO_MAX_BYTES=2000000
ENABLE_AUDIO_EXPIRY_WORKER=true
AUDIO_EXPIRY_CRON=7 * * * *
AUDIO_EXPIRY_BATCH=100

ALLOW_DEV_OTP_BYPASS=false
ENABLE_EMAIL_DEBUG=false
